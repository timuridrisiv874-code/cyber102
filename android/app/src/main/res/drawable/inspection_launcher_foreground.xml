<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the full supplied artwork in the repository. Frame the eye at launcher size. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <inset android:insetTop="28%" android:insetBottom="18%">
            <bitmap android:src="@drawable/inspection_logo_source"
                android:gravity="fill" android:filter="true" />
        </inset>
    </item>
    <item>
        <inset android:insetTop="71%">
            <shape android:shape="rectangle">
                <solid android:color="@color/inspection_launcher_background" />
            </shape>
        </inset>
    </item>
</layer-list>
