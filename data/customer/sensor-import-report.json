    "temperature": {
      "bearing": {
        "unit": "°C",
        "operator": ">",
        "warning": 75.0,
        "alarm": 90.0,
        "source": {
          "sourceId": "temperature_description",
          "file": "Температура/Описание БД (температура).docx",
          "paragraph": 8,
          "text": "Подшипник: При повышении температуры из-за сухого трения (или разрушения сепаратора) выше 75 °C срабатывает предупреждение. Выше 90 °C формируется тревога по перегреву механической части насоса (риск заклинивания)."
        },
        "approximateBaseline": 50.0,
        "baselineSource": {
          "sourceId": "temperature_description",
          "file": "Температура/Описание БД (температура).docx",
          "paragraph": 4,
          "text": "Темп. подшипника насоса (°C): Термосопротивление в корпусе подшипникового узла гидравлической части. Базовая норма ~50 °C."
        }
      },
      "winding": {
        "unit": "°C",
        "operator": ">",
        "warning": 90.0,
        "alarm": 110.0,
        "source": {
          "sourceId": "temperature_description",
          "file": "Температура/Описание БД (температура).docx",
          "paragraph": 9,
          "text": "Электродвигатель (ЭД): Если ток возрастает из-за механического сопротивления (например, при расцентровке) или если забивается крыльчатка охлаждения ЭД, температура обмоток ползет вверх. Алгоритм выдает предупреждение при >90 °C и критическую тревогу при >110 °C (риск пробоя изоляции)."
        },
        "approximateBaseline": 65.0,
        "baselineSource": {
          "sourceId": "temperature_description",
          "file": "Температура/Описание БД (температура).docx",
          "paragraph": 5,
          "text": "Темп. обмоток ЭД (°C): Термодатчики (PT100/PT1000) в статоре асинхронного электродвигателя. Базовая норма ~65 °C."
        }
      }
    }
