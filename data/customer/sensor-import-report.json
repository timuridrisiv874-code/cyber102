        "unit": "g",
        "operator": ">",
        "warning": 2.5,
        "alarm": null,
        "source": {
          "sourceId": "vibration_description",
          "file": "Вибрация/Описание БД (вибрация).docx",
          "paragraph": 12,
          "text": "При росте ВЧ шума выше 2.5 g алгоритм фиксирует начало износа подшипника или кавитационный шум."
        }
